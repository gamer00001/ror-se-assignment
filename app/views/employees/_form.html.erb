<%= form_with(model: employee, url: (employee.id || params[:id]) ? employee_path(employee.id || params[:id]) : employees_path, method: employee.id ? :patch : :post)  do |form| %>

  <div class="mb-3">
    <label for="name" class="form-label">Name</label>
    <%= form.text_field :name, class: 'form-control' %>
    
  </div>
  <div class="mb-3">
    <label for="position" class="form-label">Position</label>
    <%= form.text_field :position, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <label for="salary" class="form-label">Salary</label>
    <%= form.number_field :salary, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <label for="date_of_birth" class="form-label">Date of Birth</label>
    <%= form.date_field :date_of_birth, class: 'form-control' %>
  </div>

  <%= submit_tag "Submit", class: 'btn btn-primary' %>
<% end %>
