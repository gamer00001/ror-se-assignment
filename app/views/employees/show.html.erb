<table class="table">
  <tr>
    <th>Name</th>
    <td><%= @employee.name %></td>
  </tr>
  <tr>
    <th>Position</th>
    <td><%= @employee.position %></td>
  </tr>
  <tr>
    <th>Salary</th>  
    <td><%= @employee.salary %></td>
  </tr>
  <tr>
    <th>Date of Birth</th>  
    <td><%= @employee.date_of_birth %></td>
  </tr>
</table>

<%= link_to "Edit this employee", edit_employee_path(@employee.id) %> |
<%= link_to "Back to employees", employees_path %>