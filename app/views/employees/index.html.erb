<div class="container">
  <h1>Employees</h1>

  <table class="table">
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">Name</th>
        <th scope="col">Salary</th>
        <th scope="col">Position</th>
        <th scope="col">Date Of Birth</th>
        <th colspan="2" scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
    <%= render  @employees %>
    </tbody>
  </table>

  <%if @meta.present? %>
    <%= link_to 'First Page', employees_path(page: 1) %> |
    <%= link_to 'Next Page', employees_path(page: @meta.dig("next_page")) %> |
    <%= link_to 'Previous Page', employees_path(page: @meta.dig("prev_page")) %> |
    <%= link_to 'Last Page', employees_path(page: @meta.dig("total_pages")) %>
  <%end%>
</div>